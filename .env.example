# ==============================================================================
# Variables de entorno — Sistema de Monitoreo de Nodos y Cola de Tareas (CAO503)
# Copiar este archivo a .env antes de levantar Docker: cp .env.example .env
# ==============================================================================

# Base de datos PostgreSQL
POSTGRES_USER=monitor_user
# Obligatoria: cada quien debe cambiarla por una clave propia en su .env local (nunca se sube a Git)
POSTGRES_PASSWORD=cambia_esta_clave
# Clave del contenedor de base de datos
DB_PASSWORD=cambia_esta_clave
POSTGRES_DB=monitor_db

# API Express
API_PORT=3000
NODE_ENV=production
# Milisegundos que una tarea puede estar en PROCESSING antes de considerarse atascada
TASK_STALE_MS=60000

# Worker (Procesamiento asíncrono y reintentos)
WORKER_POLL_MS=3000
WORKER_MAX_RETRIES=3
TASK_DURATION_MS=1500
WORKER_BACKOFF_MS=1000

# Collector (Telemetría de sistema operativo)
COLLECTOR_NODE_NAME=nodo-facyt-01
COLLECTOR_INTERVAL_MS=5000

# Web (Build estático Vite)
VITE_API_URL=/api

# Gateway (Único puerto expuesto al anfitrión)
GATEWAY_PORT=8080
